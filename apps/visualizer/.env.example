# Ground view photographic tiles are requested directly by the browser.
# Either provide a MapTiler key for Satellite v4, or supply a complete XYZ
# template and its required attribution.
VITE_MAPTILER_KEY=
VITE_GROUND_IMAGERY_XYZ_TEMPLATE=
VITE_GROUND_IMAGERY_ATTRIBUTION=
VITE_GROUND_IMAGERY_TILE_SIZE=256
VITE_GROUND_IMAGERY_MAX_ZOOM=20
