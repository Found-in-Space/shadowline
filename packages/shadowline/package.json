{
  "name": "@found-in-space/shadowline",
  "version": "0.1.0-alpha.1",
  "description": "Renderer-independent eclipse geometry and portable GIS exporters for Found in Space",
  "type": "module",
  "homepage": "https://github.com/Found-in-Space/shadowline/tree/main/packages/shadowline#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Found-in-Space/shadowline.git",
    "directory": "packages/shadowline"
  },
  "bugs": {
    "url": "https://github.com/Found-in-Space/shadowline/issues"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist/**/*.js",
    "dist/**/*.d.ts",
    "dist/**/*.d.ts.map",
    "src",
    "examples",
    "CHANGELOG.md",
    "README.md"
  ],
  "scripts": {
    "build": "node ../../scripts/clean-package-dist.mjs && tsc --build",
    "prepack": "npm run build",
    "typecheck": "tsc --build --pretty false",
    "test": "vitest run"
  },
  "license": "MIT",
  "publishConfig": {
    "access": "public",
    "tag": "alpha"
  }
}
