{
  "name": "@found-in-space/shadowline-workspace",
  "version": "0.1.0-alpha.0",
  "private": true,
  "description": "Renderer-independent eclipse geometry and map examples for Found in Space",
  "type": "module",
  "license": "MIT",
  "homepage": "https://github.com/Found-in-Space/shadowline#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Found-in-Space/shadowline.git"
  },
  "bugs": {
    "url": "https://github.com/Found-in-Space/shadowline/issues"
  },
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "build": "npm run build:packages && npm run build --workspace @found-in-space/shadowline-visualizer",
    "build:packages": "npm run build --workspace @found-in-space/shadowline && npm run build --workspace @found-in-space/shadowline-astronomy-engine",
    "check": "npm run typecheck",
    "changeset": "changeset",
    "dev": "npm run dev --workspace @found-in-space/shadowline-visualizer",
    "generate:tracker-card": "npm run build:packages && node ./scripts/generate-tracker-card.mjs",
    "release:publish": "changeset publish",
    "release:check-packed-consumers": "node ./scripts/check-packed-consumers.mjs",
    "release:lockfile": "npm install --package-lock-only --ignore-scripts --no-audit --fund=false",
    "release:status": "changeset status --verbose",
    "release:version": "changeset version && npm run release:lockfile",
    "test": "vitest run",
    "test:validation": "vitest run --config vitest.validation.config.ts",
    "test:browser": "playwright test",
    "typecheck": "tsc --build --pretty false && tsc --project tsconfig.tools.json --pretty false"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "devDependencies": {
    "@changesets/cli": "2.29.7",
    "@playwright/test": "1.55.1",
    "@types/node": "22.18.6",
    "openai": "7.4.0",
    "sharp": "0.35.3",
    "topojson-client": "3.1.0",
    "typescript": "5.9.2",
    "vite": "7.3.6",
    "vitest": "3.2.7",
    "world-atlas": "2.0.2"
  }
}
